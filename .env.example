# Public URL of this website (used for canonical URLs, hreflang, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://physioart.ro

# Base URL of the existing PhysioArt client portal (Laravel app). Booking and login links point here.
# Currently the only live portal is the development instance. Change this to the production portal URL before launch.
NEXT_PUBLIC_PORTAL_URL=https://dev.physioart.ro

# Contact form delivery (server-side only). Leave empty to keep the form in "not available yet" mode:
# visitors are then told to call or email, and no message is ever reported as sent.
# Any HTTPS endpoint that accepts a JSON POST works (e.g. the portal backend, Formspree, Make, n8n, Zapier).
CONTACT_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <secret>" to the webhook.
CONTACT_WEBHOOK_SECRET=
